<?xml version="1.0" encoding="UTF-8"?>
<!--
    FF Logistic — base BOM.

    Versions only. Build conventions live in ff-base-parent.
    Entries declared before the Spring Boot import win over Spring Boot's versions.
    Spring Modulith is managed here for both sides: the modulith uses all of it, the services
    only its event publication registry, as their outbox.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.siose.ff</groupId>
    <artifactId>ff-base-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FF Logistic - Base BOM</name>
    <description>Dependency versions for the shared libraries and both FF Logistic applications</description>

    <properties>
        <!-- Latest stable Spring Boot. 4.2 is still a release candidate. -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Same AWS SDK line the modulith storage library was copied from. -->
        <aws-sdk.version>2.57.6</aws-sdk.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <!-- Orders routes with time windows (routing). The version the reference project ran. -->
        <timefold.version>2.8.0</timefold.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- This repo's libraries, released together with the BOM. -->
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.siose.ff</groupId>
                <artifactId>ff-base-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>ai.timefold.solver</groupId>
                <artifactId>timefold-solver-bom</artifactId>
                <version>${timefold.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
